generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // A URL é gerenciada pelo prisma.config.ts
}

enum Role {
  FREELANCER
  CLIENT
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  COMPLETED
}

enum InvoiceStatus {
  PENDING
  PAID
  CANCELLED
  OVERDUE
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime? // Necessário para OAuth
  image         String?   // Foto do perfil do GitHub/Google
  password      String?   // ALTERADO: Opcional para permitir login social
  role          Role      @default(FREELANCER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  // Relacionamentos Auth.js
  accounts      Account[]
  sessions      Session[]
  messages      Message[]
  clients       Client[]
}

model Client {
  id        String    @id @default(cuid())
  name      String
  email     String?
  phone     String?
  company   String?
  document  String?
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  projects  Project[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])
}

model Project {
  id          String        @id @default(cuid())
  name        String
  description String?
  value       Float         @default(0)
  status      ProjectStatus @default(PLANNING)
  
  clientId    String
  client      Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  
  shareToken    String?   @unique
  steps         ProjectStep[]
  // Relação: Um projeto pode ter várias faturas (ex: entrada + entrega)
  invoices    Invoice[]
  
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  messages    Message[]
  @@index([clientId])
}

model ProjectStep {
  id          String    @id @default(cuid())
  title       String
  description String?   @db.Text
  attachmentUrl String? 
  
  isCompleted Boolean   @default(false)
  completedAt DateTime?
  
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([projectId])
}

model Invoice {
  id              String        @id @default(cuid())
  invoiceNumber   String        @unique // Ex: INV-001
  status          InvoiceStatus @default(PENDING)
  totalAmount     Float
  dueDate         DateTime
  issuedAt        DateTime      @default(now())
  notes           String?
  
  stripeInvoiceId String?       @unique
  stripePaymentUrl String?      

  projectId       String
  project         Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([projectId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Message {
  id        String   @id @default(cuid())
  text      String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([projectId])
}